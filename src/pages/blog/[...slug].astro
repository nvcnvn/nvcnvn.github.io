---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, slugifyTag } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const { series, part } = post.data;
    if (series && part) {
      // a series reads in part order, not date order
      const parts = posts.filter((p) => p.data.series === series && p.data.part);
      return {
        params: { slug: post.id },
        props: {
          post,
          older: parts.find((p) => p.data.part === part - 1),
          newer: parts.find((p) => p.data.part === part + 1),
          series: true,
        },
      };
    }
    return { params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], series: false } };
  });
}

const { post, newer, older, series } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Updated {formatDate(updated)}</span>}
        <span>{readingTime(post.body)}</span>
      </div>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((t) => (
              <li>
                <a class="tag" href={`/tags/${slugifyTag(t)}/`}>#{t}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="post-nav" aria-label="More posts">
    {
      older && (
        <a href={`/blog/${older.id}/`}>
          <span class="label">{series ? `← Part ${older.data.part}` : '← Older'}</span>
          {older.data.title}
        </a>
      )
    }
    {
      newer && (
        <a class="next" href={`/blog/${newer.id}/`}>
          <span class="label">{series ? `Part ${newer.data.part} →` : 'Newer →'}</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>
</Base>
