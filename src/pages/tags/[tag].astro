---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  for (const p of posts) for (const t of p.data.tags) tags.set(slugifyTag(t), t);
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`#${name}`}>
  <header class="post-header">
    <h1>#{name}</h1>
    <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'} · <a href="/tags/">All tags</a></p>
  </header>
  <PostList posts={posts} />
</Base>
